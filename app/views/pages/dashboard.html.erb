<div class="main-content">
  <div class="py-4 px-2">
    <div class="dashboard-introduction d-flex flex-md-row-reverse flex-column justify-content-between text-grey text-center">
      <%= image_tag "dataforest_logo.svg", class:"dataforest-logo mb-5" %>
      <div class="text-md-start">
        <h6 class="font-helvetica-neue-lt text-uppercase">welcome to dataforest</h6>
        <h1 class="font-helvetica-neue-bd mb-3">Your Dashboard</h1>
      </div>
    </div>
    <p class="font-helvetica-neue-lt text-md-start text-center">
    DataForest is an organisation commited to the vital mission of tree planting, recognising the essential role that trees play in sustaining our environment. By focusing on reforestation and afforestation efforts, DataForest aims to combat climate change, enhance biodiversity, and restore natural habitats. The organisation engages in various initiatives that not only involve planting trees but also educating communities about the importance of forests and promoting sustainable land management practices.
    </p>
  </div>

  <!-- main content cards -->
  <div class="row card-section d-flex flex-column flex-md-row px-2 mb-4">
    <!--- card one --->
    <div class="col-12 col-md-6 col-lg-3 mb-2">
      <div class="dashboard-card d-flex flex-column">
        <div id="projects" class="rounded-top-3"></div>
        <div class="card-text bg-dark-mintgreen text-white px-3 py-3 rounded-bottom-3">
          <h6 class="font-helvetica-neue-lt text-uppercase">your</h6>
          <h2 class="font-helvetica-neue-bd">Projects</h2>
        </div>
      </div>
    </div>

    <!--- card two --->
    <div class="col-12 col-md-6 col-lg-3 mb-2">
      <div class="dashboard-card d-flex flex-column">
        <div id="data" class="rounded-top-3"></div>
        <div class="card-text bg-dark-mintgreen text-white px-3 py-3 rounded-bottom-3">
          <h6 class="font-helvetica-neue-lt text-uppercase">your</h6>
          <h2 class="font-helvetica-neue-bd">Data</h2>
        </div>
      </div>
    </div>

    <!--- card three --->
    <div class="col-12 col-md-6 col-lg-3 mb-2">
      <div class="dashboard-card d-flex flex-column">
        <div id="support" class="rounded-top-3"></div>
        <div class="card-text bg-dark-mintgreen text-white px-3 py-3 rounded-bottom-3">
          <h6 class="font-helvetica-neue-lt text-uppercase">customer</h6>
          <h2 class="font-helvetica-neue-bd">Support</h2>
        </div>
      </div>
    </div>

    <!--- half cards --->

    <!--- card four --->
    <div class="col-12 col-md-6 col-lg-3 mb-2">
      <div class="dashboard-card dashboard-card-half d-flex flex-column">
        <div class="d-flex flex-column justify-content-center dashboard-card-text rounded-3 bg-dark-mintgreen text-center text-white px-3 py-3 rounded-3">
          <div class="d-flex flex-column justify-content-between align-items-center">
            <h6 class="font-helvetica-neue-lt text-uppercase">total trees planted</h6>
            <h1 class="number font-moul-Reg">7194</h2>
          </div>
          
          <div class="tree-icons d-flex flex-row justify-content-center align-items-center flex-wrap">
            <i class="fa-solid fa-tree"></i>
            <i class="fa-solid fa-tree"></i>
            <i class="fa-solid fa-tree"></i>
            <i class="fa-solid fa-tree"></i>
            <i class="fa-solid fa-tree"></i>
            <i class="fa-solid fa-tree"></i>
            <i class="fa-solid fa-tree"></i>
            <i class="fa-solid fa-tree"></i>
            <i class="fa-solid fa-tree"></i>
            <i class="fa-solid fa-tree"></i>
            <i class="fa-solid fa-tree"></i>
            <i class="fa-solid fa-tree"></i>
          </div>
        </div>
      </div>

    <!--- card five --->
    <div class="dashboard-card dashboard-card-half d-flex flex-column">
      <div id="articles" class="rounded-top-3"></div>
      <div class="card-text bg-dark-mintgreen text-white px-3 py-3 rounded-bottom-3">
        <h6 class="font-helvetica-neue-lt text-uppercase">news</h6>
        <h2 class="font-helvetica-neue-bd">Articles</h2>
      </div>
    </div>

  </div>

</div>